# Copy to .env at the repo root. Keep secrets in the server environment only.
# The three-pane desk works without keys using labeled local screening and
# scripted doctor replies. Set the provider keys below for live Gemini replies
# and ElevenLabs speech. A configured key is not a successful provider test.
# See docs/provider-setup.md for setup, limitations, and verification steps.

PORT=8787
PUBLIC_BASE_URL=http://localhost:8787      # the URL Twilio/ElevenLabs can reach; on Vultr this is https://<domain>

# --- Identities -------------------------------------------------------------
HCP_AGENT_NAME=patel.callsign-hcp.com
BRAND_AGENT_NAME=stelazio.brand-demo.com
IMPOSTOR_AGENT_NAME=stelazio-updates.xyz
# Display identities. Inside Aftercare this agent protects the provider and the
# sender is the care-team agent, so set e.g.:
#   HCP_AGENT_NAME=lee.callsign-hcp.com  HCP_DOCTOR_NAME=Dr. Morgan Lee  HCP_SPECIALTY=Orthopedic Surgery
#   BRAND_AGENT_NAME=careteam.aftercare.work  BRAND_DISPLAY_NAME=Aftercare care team  IMPOSTOR_AGENT_NAME=aftercare-careteam.xyz
HCP_DOCTOR_NAME=Dr. Priya Patel
HCP_SPECIALTY=Cardiology
HCP_ORGANIZATION=Blacksburg Cardiology Associates
BRAND_DISPLAY_NAME=Stelazio
BRAND_ORGANIZATION=Stelazio Pharmaceuticals (demo)

# --- GoDaddy Agent Name Service --------------------------------------------
ANS_MODE=local                             # mock | local (self-hosted registry, real crypto) | real (GoDaddy ANS)
ANS_API_KEY=
ANS_API_SECRET=
ANS_API_BASE=https://api.godaddy.com/v1/ans

# --- Speech for the three-pane desk ----------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=                       # optional desk voice; default George (JBFqnCBsd6RMkjVDRZzb)
ELEVENLABS_SCREENER_VOICE_ID=              # optional override for screening-agent speech
ELEVENLABS_DOCTOR_VOICE_ID=                # optional override for simulated-doctor speech
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

# --- Legacy external/paired-phone providers -------------------------------
CALLS_MODE=real                            # real: ring the paired phone (app provider needs no keys) | mock: always run the simulated call
CALLS_PROVIDER=app                         # app (in-browser call over Wi-Fi, default) | twilio | elevenlabs
PHONE_URL=                                 # optional: override the URL shown as QR for the phone app
TWILIO_FROM_NUMBER=                        # your Twilio number in E.164, e.g. +15405551234 (twilio provider)
TWILIO_VOICE=Polly.Joanna-Neural           # any Twilio <Say> voice (twilio provider)
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=                # from ElevenLabs after attaching the Twilio number
ELEVENLABS_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- LLM: Gemini via Google AI Studio --------------------------------------
LLM_MODE=mock                              # legacy screens only: mock | real; the desk uses GEMINI_API_KEY when present
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
