# Simulation works without any of these values.
ELEVENLABS_API_KEY=
# Run npm run voice:setup after setting your key; copy the returned agent ID here.
ELEVENLABS_AGENT_ID=
# Optional: defaults to data/aftercare.sqlite
# DATABASE_PATH=data/aftercare.sqlite
# PORT=4317
# Google AI Studio key. Enables adaptive follow-up questions, text chat, and the
# clinician briefing. Without it the scripted bilingual intake still works.
GEMINI_API_KEY=
# Optional. Defaults below are chosen from measured latency, not guesswork.
# GEMINI_MODEL is used for the in-conversation clarification, which must finish
# inside the ElevenLabs 10s tool timeout (~0.9s measured). GEMINI_BRIEFING_MODEL
# is used for the clinician briefing, which has no turn deadline.
# Note: gemini-2.5-* is refused outright for API keys issued since mid-2025.
# GEMINI_MODEL=gemini-flash-lite-latest
# GEMINI_BRIEFING_MODEL=gemini-3.6-flash
# GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta
# Self-hosted LiveKit for the live nurse handoff (stage 3 of the sponsor plan).
# Without all three the app records an urgent callback task instead.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# GoDaddy Agent Name Service. Verifies the care-team service before a handoff
# carries patient context. Without it the handoff proceeds with verification
# marked unavailable; it is never shown as verified.
ANS_API_KEY=
ANS_CARE_TEAM_NAME=
# Optional overrides. ANS_RESOLVE_URL takes a {name} placeholder; set it from the
# registry's own documentation rather than trusting the built-in default.
# ANS_REGISTRY=https://api.agentnameregistry.org
# ANS_RESOLVE_URL={registry}/v1/agents/lookup?ansName={name}
# CARE_TEAM_ENDPOINT=https://careteam.example.com/api/handoff

# Deployment only. Comma-separated hostnames this server will answer for; a
# deployed host must be reached over https. Leave empty for the localhost demo.
TRUSTED_HOSTS=
# Bind address. Stays on loopback unless a deployment sets it.
# HOST=127.0.0.1

# Partner integrations only. Comma-separated exact origins allowed to call this API
# from a browser, e.g. https://provider.example.com. Empty means same-origin only,
# which is the default and what you want unless another app needs browser access.
ALLOWED_ORIGINS=

# Optional voice overrides for npm run voice:setup. Defaults are Matilda on
# eleven_multilingual_v2, chosen for a bilingual check-in with an older patient.
# ELEVENLABS_VOICE_ID=XrExE9yKIg1WjnnlVkGX
# ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

# The escalation gate (Callsign, built in). A nurse escalation is signed by the
# care-team service identity and verified by the provider's agent identity
# against this server's local ANS-shaped registry (real X.509 + transparency
# log, no external calls), then content-screened, before it reaches /provider.
# Keys and certificates are generated on first run under CALLSIGN_KEYS_DIR.
PROVIDER_NAME=Dr. Morgan Lee
PROVIDER_SPECIALTY=Orthopedic Surgery
PROVIDER_AGENT_NAME=lee.callsign-hcp.com
CARE_TEAM_AGENT_NAME=careteam.aftercare.work
CARE_TEAM_DISPLAY_NAME=Aftercare care team
# CALLSIGN_KEYS_DIR=data/callsign-keys
# ANS_MODE=local   # local (self-hosted registry, real crypto) | mock (simulated registry checks)
# PUBLIC_BASE_URL=http://localhost:4317   # used in the registry's badge URLs
