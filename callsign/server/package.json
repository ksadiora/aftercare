{
  "name": "@callsign/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/index.ts",
    "start": "tsx --env-file=../.env src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "impostor": "tsx --env-file=../.env src/scripts/impostor.ts",
    "scenarios": "tsx --env-file=../.env src/scripts/scenarios.ts",
    "test-call": "tsx --env-file=../.env src/scripts/test-call.ts",
    "register-ans": "tsx --env-file=../.env src/scripts/register-ans.ts"
  },
  "dependencies": {
    "@callsign/shared": "*",
    "@peculiar/x509": "^2.1.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "reflect-metadata": "^0.2.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
