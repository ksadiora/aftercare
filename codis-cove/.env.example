# COPY THIS FILE TO .env, THEN FILL IN .env LOCALLY.
# Keep this committed example blank. .env is ignored by Git.
# Restart npm start after changes. Never put secrets in dist/.

# GEMINI — powers Codi's general assistant.
# Get a Gemini API key from Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# NESSIE — CapitalTwo Bank's pretend-money savings ledger.
# Both your Nessie API key and a sandbox Savings account ID are required.
NESSIE_API_KEY=
NESSIE_ACCOUNT_ID=

# NOTION — reads and completes assignments in your demo classroom.
# NOTION_TOKEN is the Notion internal connection's API access token.
# Share only the intended classroom database with that connection.
NOTION_TOKEN=
# Manage data sources > Copy data source ID in Notion.
NOTION_DATA_SOURCE_ID=
# Alternative to the data source ID: a database with exactly one source.
NOTION_DATABASE_ID=
NOTION_DONE_PROPERTY=Done
NOTION_QUEST_PROPERTY=Quest
NOTION_NOTES_PROPERTY=Instructions

# Each service is optional. Leave unused credentials blank.
# PORT is a shell variable, not a .env setting: PORT=4174 npm start
